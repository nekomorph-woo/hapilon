{
  "name": "hapilon",
  "version": "0.21.18",
  "description": "HAPi",
  "private": true,
  "type": "module",
  "bin": {
    "hapilon": "./dist/cli.js",
    "hapi": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "resources",
    "scripts"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "npm run build && node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/**/*.test.js",
    "test:unit": "node --test dist/test/unit/**/*.test.js",
    "test:integration": "node --test dist/test/integration/**/*.test.js",
    "test:polaris": "node --test dist/test/polaris/*.test.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@amaster.ai/pi-browser-use": "^0.1.31",
    "@amaster.ai/pi-computer-use": "^0.1.31",
    "@anthropic-ai/sandbox-runtime": "^0.0.74",
    "@dietrichgebert/ponytail": "^5.3.2",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@ff-labs/pi-fff": "^0.11.0",
    "@narumitw/pi-btw": "^0.62.0",
    "@nklisch/pi-background-tasks": "^0.1.8",
    "@tintinweb/pi-subagents": "^0.22.0",
    "@tintinweb/pi-tasks": "^0.9.1",
    "@zhushanwen/pi-ask-user": "^7.4.1",
    "billion-context-pi": "^0.1.83",
    "effect": "^3.22.1",
    "pi-goal-x": "^0.34.1",
    "pi-web-access": "^0.44.0",
    "typescript": "5.9.3",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4"
  },
  "overrides": {
    "@zhushanwen/pi-ask-user": {
      "@earendil-works/pi-coding-agent": "$@earendil-works/pi-coding-agent",
      "@earendil-works/pi-tui": "$@earendil-works/pi-tui"
    }
  }
}