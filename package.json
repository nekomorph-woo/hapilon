{
  "name": "hapilon",
  "version": "0.1.0-alpha",
  "description": "A multi-provider coding agent powered by Pi",
  "private": true,
  "type": "module",
  "bin": {
    "hapilon": "./dist/cli.js",
    "hapi": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "npm run build && node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/**/*.test.js",
    "test:unit": "node --test dist/test/unit/**/*.test.js",
    "test:integration": "node --test dist/test/integration/**/*.test.js",
    "prepare": "npx -y -p typescript tsc -p tsconfig.json && chmod +x dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.74",
    "@dietrichgebert/ponytail": "^4.9.0",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@ff-labs/pi-fff": "^0.10.5",
    "@narumitw/pi-btw": "^0.56.0",
    "@tintinweb/pi-subagents": "^0.19.0",
    "@tintinweb/pi-tasks": "^0.9.0",
    "@zhushanwen/pi-ask-user": "^7.0.15",
    "pi-mcp-adapter": "^2.31.0",
    "pi-web-access": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}
