{
  "name": "hapilon",
  "version": "0.1.0-alpha",
  "description": "A multi-provider coding agent powered by Pi",
  "private": true,
  "type": "module",
  "bin": {
    "hapilon": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/**/*.test.js",
    "test:unit": "node --test dist/test/unit/**/*.test.js",
    "test:integration": "node --test dist/test/integration/**/*.test.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.65",
    "@earendil-works/pi-coding-agent": "0.80.8"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}
